# Machine health check (Nov 9 2026 auto-maintenance).
# Read-only: no secrets, no checkout, no third-party actions, no write permission, no push.
# It cannot turn any pay button on or change fees/odds/prizes/addresses. The site already fails closed by itself
# (pay buttons and the health panel ignore any status older than 30 minutes); this job only makes a stale or
# broken status visible: the run fails (red X + GitHub's failed-run email to the repo owner) and the run summary
# says which machines are showing maintenance.
name: machine health check
on:
  schedule:
    - cron: "7,22,37,52 * * * *"   # every 15 minutes (GitHub may delay scheduled runs)
  workflow_dispatch:
permissions: {}
concurrency:
  group: machine-health-check
  cancel-in-progress: true
jobs:
  check:
    if: github.repository == 'CBT123BOT/cbh-pair-spin'
    runs-on: ubuntu-latest
    timeout-minutes: 5
    steps:
      - name: Check public status files
        shell: python3 {0}
        run: |
          import json, os, time, urllib.request
          SITE = "https://cbt123bot.github.io/cbh-pair-spin/"
          now = int(time.time()); bad = []; rows = []
          def get(rel):
              req = urllib.request.Request(SITE + rel + "?t=" + str(now), headers={"Cache-Control": "no-cache"})
              with urllib.request.urlopen(req, timeout=20) as r:
                  d = json.loads(r.read(1_000_000).decode("utf-8", "replace"))
              if not isinstance(d, dict): raise ValueError("not an object")
              return d
          for svc, rel in (("slots", "slots_status.json"), ("coin", "mickel-pickle/coin_status.json"), ("vending", "mickel-pickle/vending_status.json")):
              try:
                  d = get(rel); u = d.get("updated_unix"); age = now - u if isinstance(u, int) and not isinstance(u, bool) else None
                  ok = d.get("service") == svc and d.get("accepting_payments") is True and d.get("fee_schedule") == "live" and age is not None and age < 1800
                  rows.append(f"| {svc} | {'open' if ok else 'maintenance'} | {age // 60 if age is not None else '?'} min |")
                  if age is None or age >= 1800: bad.append(f"{rel} stale or malformed")
              except Exception as e:
                  rows.append(f"| {svc} | maintenance | ? |"); bad.append(f"{rel} unreadable ({type(e).__name__})")
          try:
              h = get("machine_health.json"); u = h.get("updated_unix"); age = now - u if isinstance(u, int) and not isinstance(u, bool) else None
              ms = h.get("machines") if isinstance(h.get("machines"), dict) else {}
              for m in ("pair", "vault", "slots", "coin", "vending"):
                  e = ms.get(m) if isinstance(ms.get(m), dict) else {}
                  s = e.get("state") if e.get("state") in ("open", "closed", "maintenance") else "maintenance"
                  if age is None or age >= 1800: s = "maintenance"
                  rows.append(f"| health: {m} | {s} | {age // 60 if age is not None else '?'} min |")
              if age is None or age >= 1800: bad.append("machine_health.json stale or malformed")
          except Exception as e:
              bad.append(f"machine_health.json unreadable ({type(e).__name__})")
          out = ["## Machine health", "", "| item | shown as | age |", "|---|---|---|"] + rows + [""]
          out.append("All status files are fresh." if not bad else "Problems (the site already shows maintenance and keeps pay buttons off):\n" + "\n".join("- " + b for b in bad))
          with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as f: f.write("\n".join(out) + "\n")
          print("\n".join(out))
          if bad: raise SystemExit(1)
